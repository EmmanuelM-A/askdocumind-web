%%{init: {'theme': 'base', 'themeVariables': { 'lineColor': '#0F172A', 'arrowheadColor': '#0F172A', 'background': 'transparent', 'clusterBkg': '#F8FAFC', 'clusterBorder': '#CBD5E1', 'titleColor': '#0F172A' }}}%%
flowchart LR
    classDef neutral fill:#E2E8F0,stroke:#CBD5E1,color:#0F172A
    classDef core fill:#DBEAFE,stroke:#2563EB,color:#0F172A
    classDef ext fill:#E2E8F0,stroke:#2563EB,stroke-dasharray:4 3,color:#0F172A

    subgraph Development["Development"]
        GH["GitHub Repository"]
        CI["CI/CD Pipeline"]
        GH --> CI
    end

    subgraph Production["Production"]
        subgraph Railway["Railway (Hosting)"]
            Docker["Docker Container\n(FastAPI App)"]
        end
        PG[("PostgreSQL Database\n(Managed Service)")]
        CF["Cloudflare\n(Edge / DNS)"]
        Sentry["Sentry\n(Monitoring)"]
        Env["Environment Variables\n/ Secrets"]
    end

    CI -->|"deploy on push"| Docker
    Docker -->|"queries"| PG
    CF -->|"routes traffic"| Docker
    Docker -->|"errors"| Sentry
    Env -->|"injected into"| Docker

    class GH,CI neutral
    class Docker,Env core
    class PG,CF neutral
    class Sentry ext
