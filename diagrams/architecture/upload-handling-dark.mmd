%%{init: {'theme': 'base', 'themeVariables': { 'background': 'transparent', 'lineColor': '#a1a1aa', 'primaryTextColor': '#fafafa', 'edgeLabelBackground': '#131316', 'clusterBkg': '#09090b', 'clusterBorder': '#27272a', 'titleColor': '#fafafa' }}}%%
flowchart LR
    classDef core fill:#0c2340,stroke:#38bdf8,color:#fafafa
    classDef neutral fill:#131316,stroke:#27272a,color:#fafafa
    classDef ext fill:#09090b,stroke:#38bdf8,stroke-dasharray:4 3,color:#fafafa

    subgraph request["Upload request"]
        req(["File<br/>extension, MIME type,<br/>10 docs per chat"])
        pending["Row PENDING<br/>duplicate name: 409"]
        save["Read and save<br/>10 MB cap, SHA-256"]
        uploaded["Row UPLOADED<br/>respond 202"]
    end

    bucket[("Object storage<br/>chat ID / document ID")]

    subgraph background["Background ingestion"]
        task["Task, max 5 at once<br/>PROCESSING<br/>extract and chunk"]
        result{"COMPLETED<br/>or FAILED"}
    end

    openai["OpenAI<br/>text-embedding-3-small"]
    db[("pgvector<br/>chunk_embeddings")]
    sweeper["Sweeper, every 60 s<br/>retries UPLOADED at 2 min<br/>fails stuck rows at 1 h"]
    reprocess["Reprocess<br/>FAILED to UPLOADED"]
    delete["Delete document<br/>file, row, chunks"]

    req -->|file and metadata| pending
    pending -->|file stream| save
    save -->|file bytes| bucket
    save -->|size and checksum| uploaded
    uploaded -->|ingestion job| task
    bucket -->|file bytes| task
    task <-->|chunk text and vectors| openai
    task -->|chunk vectors| db
    task -->|final status| result
    sweeper -->|retry jobs| task
    result -->|failed document| reprocess
    reprocess -->|ingestion job| task
    delete -->|object key| bucket

    class req,pending,save,uploaded,task,result,sweeper,reprocess,delete core
    class bucket,db neutral
    class openai ext
