%%{init: {'theme': 'base', 'themeVariables': { 'lineColor': '#0F172A', 'arrowheadColor': '#0F172A', 'background': 'transparent', 'clusterBkg': '#F8FAFC', 'clusterBorder': '#CBD5E1', 'titleColor': '#0F172A' }}}%%
flowchart LR
    classDef neutral fill:#E2E8F0,stroke:#CBD5E1,color:#0F172A
    classDef core fill:#DBEAFE,stroke:#2563EB,color:#0F172A
    classDef ext fill:#E2E8F0,stroke:#2563EB,stroke-dasharray:4 3,color:#0F172A

    subgraph L1["Client Layer"]
        Client["API Client\n(e.g. demo frontend, developer tools)"]
    end

    subgraph L2["Infrastructure Layer"]
        CF["Cloudflare (DNS + CDN)"]
    end

    subgraph L3["Application Layer"]
        Backend["FastAPI Backend"]
    end

    subgraph L4["Services Layer"]
        DB[("PostgreSQL Database\n(relational + pgvector)")]
        APIs["External APIs\n(OpenAI, Brave Search)"]
    end

    Sentry["Sentry (Monitoring)"]

    Client --> CF
    CF --> Backend
    Backend --> DB
    Backend --> APIs
    Backend --> Sentry

    class Client neutral
    class CF neutral
    class Backend core
    class DB neutral
    class APIs,Sentry ext
