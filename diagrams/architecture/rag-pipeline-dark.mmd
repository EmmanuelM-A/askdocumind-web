%%{init: {'theme': 'base', 'themeVariables': { 'lineColor': '#94A3B8', 'arrowheadColor': '#94A3B8', 'background': 'transparent' }}}%%
flowchart LR
    classDef neutral fill:#0F172A,stroke:#1E293B,color:#E2E8F0
    classDef core fill:#082F49,stroke:#38BDF8,color:#E2E8F0
    classDef ext fill:#0F172A,stroke:#38BDF8,stroke-dasharray:4 3,color:#E2E8F0

    A["User Query"] -->|"raw question"| B["Convert to Embedding"]
    B -->|"query vector"| C[("Search Vector Database\n(pgvector)")]
    C -->|"top matches"| D["Retrieve Relevant Chunks"]
    D -->|"chunk text"| E["Send to LLM with Context"]
    E -->|"prompt + context"| F["Generate Answer\n(OpenAI API)"]
    F -->|"draft answer"| G["Add Citations\nfrom Source Documents"]
    G -->|"final answer"| H["Return Answer to User"]

    class A,B,D,E,G,H core
    class C neutral
    class F ext
