flowchart LR
    classDef neutral fill:#0F172A,stroke:#1E293B,color:#E2E8F0
    classDef core fill:#082F49,stroke:#38BDF8,color:#E2E8F0
    classDef ext fill:#0F172A,stroke:#38BDF8,stroke-dasharray:4 3,color:#E2E8F0

    subgraph Development["Development"]
        GH["GitHub Repository"]
        CI["CI/CD Pipeline"]
        GH --> CI
    end

    subgraph Production["Production"]
        subgraph Railway["Railway (Hosting)"]
            Docker["Docker Container\n(FastAPI App)"]
        end
        PG[("PostgreSQL Database\n(Managed Service)")]
        CF["Cloudflare\n(Edge / DNS)"]
        Env["Environment Variables\n/ Secrets"]
    end

    CI -->|"deploy on push"| Docker
    Docker -->|"queries"| PG
    CF -->|"routes traffic"| Docker
    Env -->|"injected into"| Docker

    class GH,CI neutral
    class Docker,Env core
    class PG,CF neutral
