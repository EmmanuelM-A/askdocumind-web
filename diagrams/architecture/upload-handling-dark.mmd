%%{init: {'theme': 'base', 'themeVariables': { 'lineColor': '#94A3B8', 'arrowheadColor': '#94A3B8', 'background': 'transparent' }}}%%
flowchart LR
    classDef neutral fill:#0F172A,stroke:#1E293B,color:#E2E8F0
    classDef core fill:#082F49,stroke:#38BDF8,color:#E2E8F0

    A["User Uploads File"]
    B{"Validate Format\n(PDF, DOCX, TXT, Markdown, CSV)"}
    C["Reject File"]
    D["Store Temporarily"]
    E["Process Document\n(Split into Chunks)"]
    F["Generate Embeddings\nfor Each Chunk"]
    G[("Store in Vector Database\n(pgvector)")]
    H["Available for Query\n(linked to session)"]
    I{"Session Expires?\n(automatic, tied to session duration)"}
    J["Delete Document & Embeddings\nfrom Database"]
    K["Cleanup Complete"]

    A --> B
    B -->|"valid"| D
    B -->|"invalid"| C
    D --> E --> F --> G --> H
    H --> I
    I -->|"yes"| J --> K
    I -->|"no, still active"| H

    class A neutral
    class D,E,F core
    class G,H neutral
    class B,I neutral
    class C,J,K neutral
