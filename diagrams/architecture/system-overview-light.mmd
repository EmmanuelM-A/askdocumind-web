%%{init: {'theme': 'base', 'themeVariables': { 'background': 'transparent', 'lineColor': '#475569', 'primaryTextColor': '#0f172a', 'edgeLabelBackground': '#f8fafc', 'clusterBkg': '#f8fafc', 'clusterBorder': '#cbd5e1', 'titleColor': '#0f172a' }}}%%
flowchart LR
    classDef core fill:#dbeafe,stroke:#2563eb,color:#0f172a
    classDef neutral fill:#e2e8f0,stroke:#cbd5e1,color:#0f172a
    classDef ext fill:#f8fafc,stroke:#2563eb,stroke-dasharray:4 3,color:#0f172a

    client["Next.js client<br/>Vercel"]
    cf["Cloudflare<br/>DNS and CDN"]

    subgraph railway["Railway, one Docker instance"]
        migrate["alembic upgrade head<br/>pre-deploy command"]
        api["FastAPI API"]
        ingest["Ingestion tasks<br/>up to 5 at once"]
        sweeper["Upload sweeper<br/>every 60 s"]
        cleaner["Expired-user cleaner<br/>every 15 min"]
        bucket[("S3 bucket<br/>Railway")]
    end

    db[("PostgreSQL + pgvector<br/>Neon")]
    openai["OpenAI<br/>embeddings and chat"]
    brave["Brave Search<br/>and result pages"]

    client -->|HTTPS requests| cf
    cf -->|API requests| api
    api -->|file bytes| bucket
    api -->|ingestion jobs| ingest
    api -->|rows and vector queries| db
    api -->|question and context| openai
    api -->|search query| brave
    bucket -->|file bytes| ingest
    ingest -->|chunk text| openai
    ingest -->|chunk vectors| db
    sweeper -->|retry jobs| ingest
    sweeper -->|stale document rows| db
    cleaner -->|expired user rows| db
    cleaner -->|chat folders to delete| bucket
    migrate -->|schema changes| db

    class client,api,ingest,sweeper,cleaner core
    class cf,migrate,bucket,db neutral
    class openai,brave ext
