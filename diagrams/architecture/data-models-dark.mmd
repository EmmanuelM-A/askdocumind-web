%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#0F172A', 'mainBkg': '#0F172A', 'primaryBorderColor': '#38BDF8', 'primaryTextColor': '#E2E8F0', 'lineColor': '#94A3B8', 'rowOdd': '#1E293B', 'rowEven': '#0F172A', 'attributeBackgroundColorOdd': '#1E293B', 'attributeBackgroundColorEven': '#0F172A' }}}%%
erDiagram
    USER ||--o{ CHAT_SESSION : has
    CHAT_SESSION ||--o{ CHAT_MESSAGE : has
    CHAT_SESSION ||--o{ DOCUMENT : has
    CHAT_SESSION ||--o{ DOCUMENT_CHUNK : "has (denormalized)"
    DOCUMENT ||--o{ DOCUMENT_CHUNK : has

    USER {
        uuid id PK
        timestamp created_at
        timestamp last_seen_at
    }

    CHAT_SESSION {
        uuid id PK
        uuid user_id FK
        text title "nullable"
        timestamp created_at
    }

    DOCUMENT {
        uuid id PK
        uuid session_id FK
        string source "filename, unique per session"
        bigint source_size
        enum source_type "UPLOAD | WEB_SEARCH"
        enum processing_status "PROCESSING | COMPLETED | FAILED"
        timestamp created_at
        timestamp updated_at
    }

    DOCUMENT_CHUNK {
        uuid id PK
        uuid document_id FK "nullable"
        uuid chat_session_id FK "denormalized"
        text chunk_text
        vector embedding "1536-dim, pgvector"
        timestamp created_at
    }

    CHAT_MESSAGE {
        uuid id PK
        uuid session_id FK
        enum role "USER | ASSISTANT"
        text content
        array sources "string[], nullable"
        timestamp created_at
    }
