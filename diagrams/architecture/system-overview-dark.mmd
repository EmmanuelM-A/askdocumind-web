flowchart LR
    classDef neutral fill:#0F172A,stroke:#1E293B,color:#E2E8F0
    classDef core fill:#082F49,stroke:#38BDF8,color:#E2E8F0
    classDef ext fill:#0F172A,stroke:#38BDF8,stroke-dasharray:4 3,color:#E2E8F0

    subgraph L1["Client Layer"]
        Client["API Client\n(e.g. demo frontend, developer tools)"]
    end

    subgraph L2["Infrastructure Layer"]
        CF["Cloudflare (DNS + CDN)"]
    end

    subgraph L3["Application Layer"]
        Backend["FastAPI Backend"]
    end

    subgraph L4["Services Layer"]
        DB[("PostgreSQL Database\n(relational + pgvector)")]
        APIs["External APIs\n(OpenAI, Brave Search)"]
    end

    Client --> CF
    CF --> Backend
    Backend --> DB
    Backend --> APIs

    class Client neutral
    class CF neutral
    class Backend core
    class DB neutral
    class APIs ext
