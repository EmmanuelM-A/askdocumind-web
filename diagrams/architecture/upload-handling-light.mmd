%%{init: {'theme': 'base', 'themeVariables': { 'lineColor': '#0F172A', 'arrowheadColor': '#0F172A', 'background': 'transparent' }}}%%
flowchart LR
    classDef neutral fill:#E2E8F0,stroke:#CBD5E1,color:#0F172A
    classDef core fill:#DBEAFE,stroke:#2563EB,color:#0F172A

    A["User Uploads File"]
    B{"Validate Format\n(PDF, DOCX, TXT, Markdown, CSV)"}
    C["Reject File"]
    D["Store Temporarily"]
    E["Process Document\n(Split into Chunks)"]
    F["Generate Embeddings\nfor Each Chunk"]
    G[("Store in Vector Database\n(pgvector)")]
    H["Available for Query\n(linked to session)"]
    I{"Session Expires?\n(automatic, tied to session duration)"}
    J["Delete Document & Embeddings\nfrom Database"]
    K["Cleanup Complete"]

    A --> B
    B -->|"valid"| D
    B -->|"invalid"| C
    D --> E --> F --> G --> H
    H --> I
    I -->|"yes"| J --> K
    I -->|"no, still active"| H

    class A neutral
    class D,E,F core
    class G,H neutral
    class B,I neutral
    class C,J,K neutral
